# SIMPKL - Sistem Informasi Pengelolaan Praktik Kerja Lapangan
# Salin file ini menjadi .env.local untuk pengembangan lokal

# URL Proyek Supabase Anda (misal: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anon Key (Aman digunakan di frontend, otorisasi melalui RLS PostgreSQL)
# PERINGATAN KEAMANAN: JANGAN PERNAH memasukkan Supabase Service Role Key di frontend!
VITE_SUPABASE_ANON_KEY=
